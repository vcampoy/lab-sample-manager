<Window x:Class="LabSampleManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LabSampleManager.Desktop.Controls"
        mc:Ignorable="d"
        Title="Lab Sample Manager"
        Icon="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/Beaker/ic_fluent_beaker_24_filled.png"
        Height="800"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        Background="#F7F9FC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="262" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:MenuControl Grid.Column="0"
                              NavigationRequested="OnNavigationRequested" />
        <ContentControl x:Name="ContentHost"
                        Grid.Column="1" />
    </Grid>
</Window>
