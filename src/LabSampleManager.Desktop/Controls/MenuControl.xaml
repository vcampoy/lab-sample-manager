<UserControl x:Class="LabSampleManager.Desktop.Controls.MenuControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LabSampleManager.Desktop.Controls"
             Width="262"
             MinWidth="220"
             HorizontalAlignment="Left"
             Background="#F7F9FC">
    <UserControl.Resources>
        <Style x:Key="MenuItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#294265" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24"
                                      Height="24"
                                      Margin="0,0,20,0">
                                    <Image x:Name="RegularIcon"
                                           Source="{Binding (controls:MenuControl.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                                           Stretch="Uniform" />
                                    <Image x:Name="FilledIcon"
                                           Source="{Binding (controls:MenuControl.SelectedIconSource), RelativeSource={RelativeSource TemplatedParent}}"
                                           Stretch="Uniform"
                                           Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E1EFFC" />
                                <Setter Property="Foreground" Value="#0B63B6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#D5E8FA" />
                                <Setter Property="Foreground" Value="#084D92" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="RegularIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="FilledIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,28,24,36">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="HeaderPlaceholder"
                       Width="30"
                       Height="30"
                       Margin="0,0,14,0"
                       Source="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/Beaker/ic_fluent_beaker_24_filled.png"
                       ToolTip="icon-lab-sample-manager"
                       AutomationProperties.Name="icon-lab-sample-manager" />
                <TextBlock Text="Lab Sample Manager"
                           VerticalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#142C4C" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="Dashboard"
                         Content="Dashboard"
                         controls:MenuControl.IconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/Home/ic_fluent_home_24_regular.png"
                         controls:MenuControl.SelectedIconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/Home/ic_fluent_home_24_filled.png"
                         ToolTip="icon-dashboard"
                         AutomationProperties.Name="icon-dashboard"
                         Style="{StaticResource MenuItemStyle}"
                         IsChecked="True"
                         Click="OnMenuItemClick" />
            <RadioButton x:Name="Samples"
                         Content="Samples"
                         controls:MenuControl.IconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/DocumentText/ic_fluent_document_text_24_regular.png"
                         controls:MenuControl.SelectedIconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/DocumentText/ic_fluent_document_text_24_filled.png"
                         ToolTip="icon-samples"
                         AutomationProperties.Name="icon-samples"
                         Style="{StaticResource MenuItemStyle}"
                         Click="OnMenuItemClick" />
            <RadioButton x:Name="RegisterSample"
                         Content="Register Sample"
                         controls:MenuControl.IconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/AddCircle/ic_fluent_add_circle_24_regular.png"
                         controls:MenuControl.SelectedIconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/AddCircle/ic_fluent_add_circle_24_filled.png"
                         ToolTip="icon-register-sample"
                         AutomationProperties.Name="icon-register-sample"
                         Style="{StaticResource MenuItemStyle}"
                         Click="OnMenuItemClick" />
            <RadioButton x:Name="Processing"
                         Content="Processing"
                         controls:MenuControl.IconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/Settings/ic_fluent_settings_24_regular.png"
                         controls:MenuControl.SelectedIconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/Settings/ic_fluent_settings_24_filled.png"
                         ToolTip="icon-processing"
                         AutomationProperties.Name="icon-processing"
                         Style="{StaticResource MenuItemStyle}"
                         Click="OnMenuItemClick" />
            <RadioButton x:Name="Validation"
                         Content="Validation"
                         controls:MenuControl.IconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/CheckmarkCircle/ic_fluent_checkmark_circle_24_regular.png"
                         controls:MenuControl.SelectedIconSource="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Icons/Fluent/CheckmarkCircle/ic_fluent_checkmark_circle_24_filled.png"
                         ToolTip="icon-validation"
                         AutomationProperties.Name="icon-validation"
                         Style="{StaticResource MenuItemStyle}"
                         Click="OnMenuItemClick" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="32,24,24,28">
            <TextBlock Text="Doing now what patients needs next"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#7087A4" />
            <Image x:Name="RocheLogoPlaceholder"
                   Width="84"
                   Height="34"
                   Margin="0,14,0,0"
                   HorizontalAlignment="Left"
                   Source="pack://application:,,,/LabSampleManager.Desktop;component/Assets/Images/roche-logo-blue.png"
                   ToolTip="logo-roche"
                   AutomationProperties.Name="logo-roche" />
        </StackPanel>
    </Grid>
</UserControl>

