<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LabSampleManager.Desktop.Controls" xmlns:resources="clr-namespace:LabSampleManager.Desktop.Properties">
    <SolidColorBrush x:Key="Field.Border" Color="#B8C7DC"/><SolidColorBrush x:Key="Field.Focus" Color="#1768D7"/><SolidColorBrush x:Key="Field.Text" Color="#142033"/><SolidColorBrush x:Key="Field.Muted" Color="#6B82A4"/><SolidColorBrush x:Key="Field.Error" Color="#D70015"/>
    <Style TargetType="{x:Type local:TextBoxControl}"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Field.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Field.Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="42"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:TextBoxControl}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Field.Text}"/><TextBlock x:Name="PART_Indicator" Grid.Column="1" Text="{x:Static resources:Resources.RequiredFieldIndicator}" Foreground="{DynamicResource Field.Error}" Margin="4,0,0,0" Visibility="Collapsed"/><Border Margin="0,8,0,0" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></Grid><TextBlock Text="{TemplateBinding SubTitle}" Margin="0,4,0,0" Foreground="{DynamicResource Field.Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Field.Focus}"/></Trigger><Trigger Property="ShowFieldIndicator" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
