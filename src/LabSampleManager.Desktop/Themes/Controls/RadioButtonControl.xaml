<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LabSampleManager.Desktop.Controls" xmlns:resources="clr-namespace:LabSampleManager.Desktop.Properties"><Style TargetType="{x:Type local:RadioButtonControl}"><Setter Property="Foreground" Value="{DynamicResource Field.Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,20,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:RadioButtonControl}"><Border x:Name="PART_RadioBorder" Padding="0,6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="PART_OuterCircle" Width="18" Height="18" Stroke="{DynamicResource Field.Border}" StrokeThickness="1.5"/><Ellipse x:Name="PART_InnerCircle" Width="8" Height="8" Fill="{DynamicResource Field.Focus}" Visibility="Collapsed" Margin="-13,0,0,0"/><ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="PART_InnerCircle" Property="Visibility" Value="Visible"/><Setter TargetName="PART_OuterCircle" Property="Stroke" Value="{DynamicResource Field.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ResourceDictionary>
