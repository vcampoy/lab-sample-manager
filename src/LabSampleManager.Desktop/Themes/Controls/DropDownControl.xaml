<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LabSampleManager.Desktop.Controls" xmlns:resources="clr-namespace:LabSampleManager.Desktop.Properties">
    <Style TargetType="{x:Type local:DropDownControl}"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Field.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Field.Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="42"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:DropDownControl}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold"/><TextBlock x:Name="PART_Indicator" Grid.Column="1" Text="{x:Static resources:Resources.RequiredFieldIndicator}" Foreground="{DynamicResource Field.Error}" Margin="4,0,0,0" Visibility="Collapsed"/><Border x:Name="PART_DropDownBorder" Grid.ColumnSpan="2" Margin="0,8,0,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><Grid><ToggleButton x:Name="PART_ToggleButton" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ContentPresenter Margin="12,9" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"/></ToggleButton><TextBlock Text="{x:Static resources:Resources.DropDownIndicator}" FontSize="18" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="PART_DropDownBorder" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="{DynamicResource Field.Border}" BorderThickness="1"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><TextBlock Text="{TemplateBinding SubTitle}" Margin="0,4,0,0" Foreground="{DynamicResource Field.Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Field.Focus}"/></Trigger><Trigger Property="ShowFieldIndicator" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
